# Default ignore — applies to all builds with context=repo root.
# Dockerfiles use explicit COPY paths, so this mainly trims the context sent to the daemon.

__pycache__
*.pyc
*.pyo
*.pyd

.git
.gitignore
.gitattributes

.env
.env.*
!.env.example

.venv
venv

.claude
.vscode
.idea

# Knowledge base + workflow assets — not used at runtime by the API/worker.
**/knowledge-base/
**/workflows/
infrastructure/
# shared/ IS included in the worker build context as of 2026-05-28 — the
# Instantly reply drafter loads shared/context/identity/pang.md at runtime.
# The api Dockerfile does not COPY it, so it stays out of the api image.

# Build artefacts
**/celerybeat-schedule
**/*.log
node_modules
