celerybeat-schedule
celerybeat-schedule.*
.archive
# Google OAuth secrets (never commit)
credentials.json
token.json

# Lead lists / scraped prospect data — real PII, never commit (repo is PUBLIC)
divinecore-v2/worker/sales_os/Clients/divinecore/data/
sales_os/calls/data/
*verified-leads*.csv

# Local Claude Code state (machine-specific, not shared)
.claude/settings.local.json
.claude/session.md

# Internal meeting transcripts pulled for context work (never push to public repo)
.claude/_transcripts_tmp/

# Social post tracker data — your own LinkedIn impressions are private analytics (repo is PUBLIC)
tools/social-tracker/posts.csv
tools/social-tracker/.inbox.txt
tools/social-tracker/.import-*.json
tools/social-tracker/.impressions-fill.txt
tools/social-tracker/dashboard.html
tools/social-tracker/.crm-preview.html
tools/social-tracker/.crm-auth

# Client builds — client IP and generated client content never goes public (repo is PUBLIC)
clients/*/templates/
clients/*/review/
clients/*/outputs/
clients/*/resources/

# Corpus (raw books, syllabus PDFs, PYQ papers) — copyrighted/licensed source
# material, never goes public (repo is PUBLIC). Moved from clients/target-academy/
# to DsideOS/ (2026-08-18 reorg, genuinely client-agnostic) — this rule MUST
# track wherever corpus/ actually lives, or a reorg silently un-ignores it
# (see incident: 2026-08-19, 1.2GB of corpus committed in 8cfc8a9 because this
# line still said clients/*/corpus/ after the move).
DsideOS/corpus/

# RAG ingest checkpoints — full copyrighted book text (client IP, repo is PUBLIC).
# Kept locally only; regenerable by re-running segmentation. Same reorg as above.
DsideOS/rag/.checkpoints/
DsideOS/rag/.reocr/
DsideOS/rag/.translate/
