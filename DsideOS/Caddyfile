# ⚠ DEAD CONFIG — NOT IN USE. Kept as a record of the original design only.
#
# The server runs NGINX, not Caddy (verified on the box 2026-09-17: no Caddy
# container, `systemctl is-active caddy` = inactive). Real routing lives in
# /etc/nginx/sites-enabled/{dsideos,dsideos-console,crm,n8n,app}, and TLS is
# Certbot, not Caddy's automatic HTTPS.
#
# This file is also WRONG about the frontend: it proxies / to `frontend:3000`,
# but no frontend container runs — nginx serves the landing page as static files
# from /var/www/dsideos-landing. See DEPLOY.md's "AS ACTUALLY DEPLOYED" section.
#
# Editing this file changes nothing in production.

# Caddy reverse proxy — automatic HTTPS via Let's Encrypt.
# One public domain, path-split between frontend and backend.
#
#   dsideos.divinesideai.com/api/*  -> the FastAPI backend (this repo)
#   dsideos.divinesideai.com/*      -> the frontend container
#
# Caddy obtains + renews the TLS cert automatically on first request, as long as
# the DNS A record for dsideos.divinesideai.com points at this server and ports
# 80 + 443 are open in the Hetzner firewall.

dsideos.divinesideai.com {
	# Backend API — strip nothing; FastAPI routes are already under /api/*.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Everything else -> the frontend container.
	# (Frontend image + service name "frontend" come from the frontend repo;
	# see docker-compose.prod.yml for the placeholder service.)
	handle {
		reverse_proxy frontend:3000
	}

	encode gzip
}
