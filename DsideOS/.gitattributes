# Force LF on files that run on the Linux server/containers — CRLF breaks
# Dockerfiles, shell scripts, and entrypoints when checked out on Windows.
*.py        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Caddyfile   text eol=lf
*.sh        text eol=lf
.env.example text eol=lf
