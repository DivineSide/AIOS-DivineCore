# Copy to .env and fill in. The .env file is gitignored.

# Redis broker + result backend (compose sets this to redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# LLM providers. OpenAI is PRIMARY for text (extraction, explanations); Claude is
# the automatic fallback on quota/auth errors, and the vision path. Set both.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Sarvam AI (used when GEN_PROVIDER=sarvam)
SARVAM_API_KEY=
GEN_PROVIDER=sarvam
SARVAM_MODEL=sarvam-105b
SARVAM_MAX_TOKENS=4096
SARVAM_BATCH=4
SARVAM_REASONING=low

# Which provider leads. "openai" (default) | "anthropic". If set to openai but no
# OPENAI_API_KEY is present, the code starts on anthropic automatically.
LLM_PRIMARY=openai

# --- RAG retrieval quality (question generation) ---
# Hybrid retrieval: fuse dense (embeddings) + lexical (Postgres full-text/BM25)
# via RRF. Recovers exact-token/year/name facts dense-only misses. In-DB, ~free.
RAG_HYBRID=1
# HyDE: embed a hypothetical answer sentence (gpt-5.4-nano) instead of the raw
# topic, so retrieval matches passage-shaped text. ~Rs0.85/100Q.
RAG_HYDE=1
# (Agentic re-retrieval — re-query wider on a grounding miss — is automatic; no flag.)

# --- Grounding gate (the verifier that rejects ungrounded questions) ---
# Judge provider: "anthropic" (Haiku) | "openai" (gpt-5.4-nano, ~4-5x cheaper,
# validated to match Haiku). Must NOT be the drafting model (GEN_PROVIDER).
GROUND_PROVIDER=openai
GROUND_MODEL=gpt-5.4-nano
GEN_GROUNDING=1

# Where job folders live (compose mounts a volume at /data/jobs)
JOBS_DIR=/data/jobs

# Auto-delete job folders older than this many hours
JOB_TTL_HOURS=24

# Max upload size in MB
MAX_UPLOAD_MB=50
